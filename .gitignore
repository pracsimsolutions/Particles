# OS
Thumbs.db
Desktop.ini
.DS_Store

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# FlexSim
# (working/backup files emitted next to .fsm during a session)
*.fsm.bak
*.fsm.lock
*.fsm.tmp

# Build artifacts — contributors build these locally.
# Particles.dll is regenerated locally by a Visual Studio build (policy
# 2026-09-14, supersedes the prior "prebuilt, committed" policy — the
# installer build now builds the module itself instead of reading a
# committed binary; scripts/build-module.bat can build it headlessly).
# Particles.t is regenerated by FlexSim on Save Defaults from the .fsx.
/Particles.dll
Particles.t
Particles.lib
Particles.exp
Particles.pdb
Particles.iobj
Particles.ipdb

# Temp build target used to avoid locking the live Particles.dll while FlexSim runs
# (build to Particles_lt, then copy over Particles.dll).
Particles_lt.dll
Particles_lt.lib
Particles_lt.exp
Particles_lt.pdb
Particles_lt.iobj
Particles_lt.ipdb

# Superpowers brainstorming companion (mockups, session state)
.superpowers/

# Internal design notes / research — not shipped with the public module.
docs/

# ParticlesDLL build artifacts. msbuild nests intermediate files under
# ParticlesDLL/ParticlesDLL/x64/ while the final DLL ends up at
# ParticlesDLL/x64/Release/ — the ** glob catches both.
ParticlesDLL/flexsimcontent/
ParticlesDLL/**/x64/
ParticlesDLL/.vs/
ParticlesDLL/*.user
