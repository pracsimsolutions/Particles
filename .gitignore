# OS
Thumbs.db
Desktop.ini
.DS_Store

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# FlexSim
# (working/backup files emitted next to .fsm during a session)
*.fsm.bak
*.fsm.lock
*.fsm.tmp

# Build artifacts — contributors build these locally.
# Particles.dll is produced by Visual Studio building ParticlesDLL.sln.
# Particles.t is regenerated by FlexSim on Save Defaults from the .fsx.
Particles.dll
Particles.t
Particles.lib
Particles.exp
Particles.pdb
Particles.iobj
Particles.ipdb

# Temp build target used to avoid locking the live Particles.dll while FlexSim runs
# (build to Particles_lt, then copy over Particles.dll).
Particles_lt.dll
Particles_lt.lib
Particles_lt.exp
Particles_lt.pdb
Particles_lt.iobj
Particles_lt.ipdb

# Superpowers brainstorming companion (mockups, session state)
.superpowers/

# ParticlesDLL build artifacts. msbuild nests intermediate files under
# ParticlesDLL/ParticlesDLL/x64/ while the final DLL ends up at
# ParticlesDLL/x64/Release/ — the ** glob catches both.
ParticlesDLL/flexsimcontent/
ParticlesDLL/**/x64/
ParticlesDLL/.vs/
ParticlesDLL/*.user
